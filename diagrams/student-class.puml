@startuml student-class
title 學生端搶答系統 — Class Diagram (001-student-buzzer)
skinparam defaultFontName "Microsoft JhengHei"
skinparam backgroundColor #FAF7F0
skinparam class {
  BackgroundColor #F5F0E6
  BorderColor #1F3A93
  ArrowColor #1F3A93
}
hide empty members

enum ActivityPhase {
  WAITING  等待開放
  ANSWERING  作答中
  CLOSED  已結束
  ENDED  活動結束
}

enum SubmitError {
  VALIDATION_ERROR  欄位格式不正確
  EMPTY_ANSWER  答案不可為空
  ANSWER_TOO_LONG  答案最多 500 字
  UNAUTHORIZED  尚未登入或登入已過期
  NO_TEAM  尚未被分配到組別
  QUESTION_NOT_OPEN  此題目目前未開放作答
  QUESTION_CLOSED  本題搶答已結束
  ALREADY_SUBMITTED  本組已送出
  ACTIVITY_ENDED  活動已結束
}

class Activity <<同時只有一場>> {
  +activityId: string
  +phase: ActivityPhase
  +currentQuestionId: string?
  +endsAt: datetime?
  +openQuestion(questionId, seconds)
  +closeQuestion(reason)
  +backToWaiting()
  +endActivity()
  +reset()  (dev only)
  +recoverAfterRestart()
}

class Question {
  +questionId: string
  +number: int
  +text: string
}

class Team {
  +teamId: string
  +name: string
}

class Student {
  +studentId: string
  +name: string
  +teamId: string
}

class Submission {
  +activityId: string
  +questionId: string
  +teamId: string
  +studentId: string
  {field} +answer: string [1..500 字]
  {field} +receivedAt: datetime [伺服器時間]
  +rank: int
}

class QuestionResult {
  +activityId: string
  +question_id: string
  +answer: string?
  +winner_team: string?
  +submitted_at: datetime?
  +closed_reason: TIME_UP | MANUAL | ACTIVITY_ENDED
}

class StudentView {
  +phase: ActivityPhase
  +question: Question?
  +endsAt: datetime?
  +serverNow: datetime
  +myTeamSubmitted: bool
  +myTeamAnswer: string?
  {field} +results: TeamAnswer[] [僅 CLOSED]
  {field} +myTeamOutcome: WIN | LOSE | NOT_SUBMITTED [僅 CLOSED]
}

class TeamAnswer {
  +rank: int
  +teamName: string
  +answer: string
  +isWinner: bool
}

class SubmissionService {
  +submit(studentId, questionId, answer): Submission | SubmitError
  -validate(answer): SubmitError?
}

class VisibilityFilter {
  +buildView(activity, student): StudentView
}

class ResultService {
  +finalize(activityId, questionId, submissions, reason): QuestionResult
}

class MockTeacherControl <<dev only>> {
  +open(questionId, seconds = 60)  (5..600)
  +timeUp()
  +manualClose()
  +nextQuestion()
  +endActivity()
  +reset()
}

Activity "1" --> "0..1" Question : current
Activity "1" o-- "*" Question
Activity "1" o-- "*" Team
Team "1" o-- "1..*" Student
Submission "*" --> "1" Question
Submission "*" --> "1" Team : 每組每題至多 1 筆
Submission "*" --> "1" Student : submittedBy
QuestionResult "0..1" --> "1" Question
QuestionResult ..> Submission : winner = rank 1
StudentView *-- "*" TeamAnswer

SubmissionService ..> Activity : 檢查 phase
SubmissionService ..> Submission : creates
SubmissionService ..> SubmitError
VisibilityFilter ..> StudentView : creates
VisibilityFilter ..> Submission : 作答中只取本組
ResultService ..> QuestionResult : creates
MockTeacherControl ..> Activity : 驅動狀態機
@enduml
