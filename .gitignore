# 環境變數（機敏資料，依憲章原則 III 不得進版控）
.env
.env.*
!.env.template

# Google 服務帳號金鑰等憑證檔
*.pem
*.key
credentials*.json
service-account*.json

# 本機資料庫（SQLite 主檔與 WAL/SHM 暫存檔，可能含帳號與密碼雜湊）
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# 本機工具（PlantUML CLI，各自下載，不進版控）
plantuml*.jar

# 相依套件
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# 建置輸出
dist/
build/
out/
.next/

# 測試與覆蓋率
coverage/
.pytest_cache/
.nyc_output/

# Log
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 編輯器與作業系統
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code 個人設定
.claude/settings.local.json
