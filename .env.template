# 複製本檔為 .env 並填入實際值；.env 已列入 .gitignore，請勿提交。
#   cp .env.template .env
# 依憲章原則 III，本檔只列變數名稱，不得填入任何真實值。
# 規則見 specs/001-user-login/research.md R8。

# 資料庫：SQLite 檔案路徑，例如 file:./dev.db（相對於 backend/ 目錄）
DATABASE_URL=

# 簽署登入 cookie 的金鑰，至少 32 字元的隨機字串
SESSION_SECRET=

# 新增／重設學生帳號時使用的統一預設密碼（8–64 字元）
STUDENT_DEFAULT_PASSWORD=

# 系統初始化老師帳號時使用的密碼（8–64 字元）
TEACHER_INITIAL_PASSWORD=

# （選填）老師帳號名稱，預設 teacher；1–20 字元、不含空白、不可為 9 位數字
TEACHER_USERNAME=

# （選填）後端埠號，預設 3000
PORT=

# （選填）development／test／production；production 時 cookie 加 Secure
NODE_ENV=
