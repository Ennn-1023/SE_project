# 複製本檔為 .env 並填入實際值；.env 已列入 .gitignore，請勿提交。
#   Copy-Item .env.template .env

# 自動建立學生帳號時使用的統一預設密碼（F1）
STUDENT_DEFAULT_PASSWORD=

# JWT 簽章金鑰（必要，至少 32 字元的隨機字串）
#   產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 後端 port（預設 3000）
PORT=3000

# SQLite 資料庫路徑（相對於 backend/；測試時使用 :memory:）
SQLITE_PATH=./data/buzzer.db

# 允許的前端來源（CORS）
CLIENT_ORIGIN=http://localhost:5173

# 是否啟用 mock 登入與模擬老師操作（僅開發用，production 禁止設為 true）
ENABLE_DEV_TOOLS=true

# development / test / production
NODE_ENV=development
