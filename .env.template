# 複製本檔為 .env 並填入實際值；.env 已列入 .gitignore，請勿提交（憲章原則 III）。
#   cp .env.template .env
# 規則與預設值見 specs/001-foundation-auth-groups/research.md R10。

# ---- 必填 ----
# 老師建立學生帳號時使用的統一預設密碼（4–64 字元）
STUDENT_DEFAULT_PASSWORD=
# 老師帳號初始密碼（8–64 字元；只在帳號首次建立時使用）
TEACHER_INITIAL_PASSWORD=
# 登入憑證簽章金鑰（至少 32 字元的隨機字串）
SESSION_SECRET=

# ---- 選填（留空則使用預設值）----
# 老師帳號（4–20 英數字，預設 teacher）
TEACHER_ACCOUNT=
# SQLite 檔案位置（相對於 backend/，預設 ./data/app.db）
DATABASE_PATH=
# 後端連接埠（1–65535，預設 3000）
PORT=
# 閒置逾時分鐘數（5–1440，預設 120）
SESSION_IDLE_MINUTES=
# development / test / production（預設 development）
NODE_ENV=
# 允許的前端來源（CORS 與 Socket.IO；預設 http://localhost:5173）
CLIENT_ORIGIN=
# 是否啟用模擬老師搶答操作的開發工具（true／false，預設 false；production 不得為 true）
ENABLE_DEV_TOOLS=

# ---- Google 試算表串接（選填；F3/F4，見 specs/003-sheets-question-import/research.md R10）----
# 下列前三個變數須「全部填寫」或「全部留空」；全部留空時系統照常啟動，只有題目匯入功能顯示未設定。
# Google OAuth 用戶端 ID（以 .apps.googleusercontent.com 結尾）
GOOGLE_CLIENT_ID=
# Google OAuth 用戶端密鑰
GOOGLE_CLIENT_SECRET=
# 加密保存 Google token 的金鑰：base64 編碼、解碼後恰好 32 bytes
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# OAuth 回呼網址（http(s):// 開頭；預設 {CLIENT_ORIGIN}/api/google/oauth/callback，須與 Google Cloud Console 設定一致）
GOOGLE_OAUTH_REDIRECT_URI=
